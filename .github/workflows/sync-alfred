name: Sync Codebase Snapshot to Alfred on: push: branches: - main - master jobs: sync-codebase: runs-on: ubuntu-latest steps: - name: Checkout Code uses: actions/checkout@v4 - name: Bundle Core Frontend &amp; Logic Files id: bundle run: | mkdir -p .github/scripts # Script to aggregate core files into a single structured markdown payload cat &lt;&lt; 'EOF' &gt; bundle.js const fs = require('fs'); const path = require('path'); const targetFiles = [ 'src/components/AlfredTerminal.tsx', 'src/components/KanbanCanvas.tsx', 'src/components/WorkspaceConsole.tsx', 'src/components/SkyHeader.tsx', 'src/types/index.ts', 'README.md' ]; let bundledContent = \`# 🛰️ SZS BRIDGE HUD — LIVE CODEBASE SNAPSHOT\\n\\n\`; bundledContent += \`\*\*Timestamp\*\*: ${new Date().toISOString()}\\n\`; bundledContent += \`\*\*Commit\*\*: ${process.env.GITHUB\_SHA || 'N/A'}\\n\\n---\\n\\n\`; targetFiles.forEach(filePath =&gt; { if (fs.existsSync(filePath)) { const content = fs.readFileSync(filePath, 'utf8'); bundledContent += \`## FILE: ${filePath}\\n\\\`\\\`\\\`typescript\\n${content}\\n\\\`\\\`\\\`\\n\\n---\\n\\n\`; } else { bundledContent += \`## FILE: ${filePath} (NOT FOUND)\\n\\n---\\n\\n\`; } }); fs.writeFileSync('CODEBASE\_SNAPSHOT.md', bundledContent); EOF node bundle.js - name: Post Snapshot to Apps Script Web App run: | PAYLOAD=$(jq -n --rawfile content CODEBASE\_SNAPSHOT.md '{"secret": "'"$APPS\_SCRIPT\_SECRET"'", "action": "UPDATE\_CODEBASE\_SNAPSHOT", "content": $content}') curl -X POST \\ -H "Content-Type: application/json" \\ -d "$PAYLOAD" \\ "${{ secrets.APPS\_SCRIPT\_WEB\_APP\_URL }}" env: APPS\_SCRIPT\_SECRET: ${{ secrets.SZS\_SECURE\_TOKEN }}
