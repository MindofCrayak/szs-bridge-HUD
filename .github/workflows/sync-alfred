name: Sync Codebase Snapshot to Alfred

on:
  push:
    branches:
      - main
      - master

jobs:
  sync-codebase:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Bundle Core Frontend & Logic Files
        id: bundle
        run: |
          mkdir -p .github/scripts

          # Script to aggregate core files into a single structured markdown payload
          cat << 'EOF' > bundle.js
          const fs = require('fs');
          const path = require('path');

          const targetFiles = [
            'src/components/AlfredTerminal.tsx',
            'src/components/KanbanCanvas.tsx',
            'src/components/WorkspaceConsole.tsx',
            'src/components/SkyHeader.tsx',
            'src/types/index.ts',
            'README.md'
          ];

          let bundledContent = `# 🛰️ SZS BRIDGE HUD — LIVE CODEBASE SNAPSHOT\n\n`;
          bundledContent += `**Timestamp**: ${new Date().toISOString()}\n`;
          bundledContent += `**Commit**: ${process.env.GITHUB_SHA || 'N/A'}\n\n---\n\n`;

          targetFiles.forEach(filePath => {
            if (fs.existsSync(filePath)) {
              const content = fs.readFileSync(filePath, 'utf8');
              bundledContent += `## FILE: ${filePath}\n\`\`\`typescript\n${content}\n\`\`\`\n\n---\n\n`;
            } else {
              bundledContent += `## FILE: ${filePath} (NOT FOUND)\n\n---\n\n`;
            }
          });

          fs.writeFileSync('CODEBASE_SNAPSHOT.md', bundledContent);
          EOF

          node bundle.js

      - name: Post Snapshot to Apps Script Web App
        run: |
          PAYLOAD=$(jq -n --rawfile content CODEBASE_SNAPSHOT.md '{"secret": "'"$APPS_SCRIPT_SECRET"'", "action": "UPDATE_CODEBASE_SNAPSHOT", "content": $content}')

          curl -X POST \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD" \
            "https://script.google.com/macros/s/AKfycbyPqkuQLlZAG5MlYl_4SkYbUv19pA44IXaxDhsTpNSzc2KgJiV2OuC1gKTMQp_Hc__Y/exec"
        env:
          APPS_SCRIPT_SECRET: ${{ secrets.SZS_SECURE_TOKEN }}